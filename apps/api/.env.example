# pgx (apps/api) rejects Prisma's ?schema=public as an unknown server
# runtime parameter — keep that param in packages/db/.env only.
DATABASE_URL="postgresql://clc:clc@localhost:5433/clc?sslmode=disable"
NEXULEX_API_BASE_URL="https://api.nexulex.com"
NEXULEX_DEVELOPER_API_KEY=""
PORT=4000
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
