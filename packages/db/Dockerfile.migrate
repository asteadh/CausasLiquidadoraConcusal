FROM node:22-alpine

RUN apk add --no-cache postgresql-client bash openssl

WORKDIR /app

COPY packages/db/prisma ./prisma
COPY packages/db/prisma.config.ts ./prisma.config.ts

RUN npm init -y >/dev/null && \
    npm install --no-save --no-audit --no-fund --loglevel=error \
        prisma@7.8.0 \
        @prisma/client@7.8.0 \
        @prisma/adapter-pg@7.8.0 \
        @prisma/client-runtime-utils@7.8.0 \
        pg@8.20.0 \
        dotenv@17.4.2
RUN DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" npx --yes prisma generate

CMD ["npx", "prisma", "migrate", "deploy"]
